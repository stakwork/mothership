# Plugin build output (built per-host, never checked in).
build/

# Wrapper binary. `go build ./...` in wrapper/ emits an executable named
# after the directory (`wrapper`); the real one is built in the
# Dockerfile's wrapper-builder stage. Never check the local copy in.
wrapper/wrapper

# Bifrost runtime state (config DB, logs DB, log files).
data/config.db
data/config.db-*
data/logs.db
data/logs.db-*
data/logs/

# Vite output for the admin UI. The real bundle is produced inside
# the Dockerfile's ui-builder stage and embedded via `go:embed`;
# anything Vite writes locally for `npm run build` lives here and
# is never checked in. The placeholder index.html + .gitkeep keep
# the directory non-empty so `go build` works without Vite.
internal/adminapi/ui/node_modules/
internal/adminapi/ui/dist/*
!internal/adminapi/ui/dist/.gitkeep
!internal/adminapi/ui/dist/index.html

# Local overrides.
.env

# Carried over from stakgraph's root .gitignore, which used to cover this
# tree: OS/editor noise, any node_modules, sqlite files, and npm lockfiles
# except the admin SPA's (its image build runs `npm ci` from it, so local,
# CI and the release image all install the same tree).
.DS_Store
.vscode
node_modules/
*.db
package-lock.json
!internal/adminapi/ui/package-lock.json

# Worktrees of this repo (git worktree add .claude/worktrees/<name>).
.claude/worktrees/
